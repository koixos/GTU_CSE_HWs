vlog -vlog01compat -work work +incdir+C:/Workspace/emb/module {C:/Workspace/emb/module/edg_ram_dual.v}
vlog -vlog01compat -work work +incdir+C:/Workspace/emb/module {C:/Workspace/emb/module/Gx.v}
vlog -vlog01compat -work work +incdir+C:/Workspace/emb/module {C:/Workspace/emb/module/Gy.v}
vlog -vlog01compat -work work +incdir+C:/Workspace/emb/module {C:/Workspace/emb/module/control_unit.v}
vlog -vlog01compat -work work +incdir+C:/Workspace/emb/module {C:/Workspace/emb/module/my_module.v}

